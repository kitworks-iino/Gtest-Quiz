# Only needed for local question generation; learning and tests need no key.
# In GitHub Actions, use the GEMINI_API_KEY repository secret.
GEMINI_API_KEY=your_gemini_api_key_here
# Resolve the newest eligible general-text model using the live model list
# and Google's standard Free Tier input/output pricing. No fixed model ID.
# Free Tier eligibility does not establish this API project's billing tier.
GEMINI_MODEL=auto
